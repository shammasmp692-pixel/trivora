# Copy to .env (never commit it). Loaded by server/index.js without extra dependencies.
PORT=3000
# WhatsApp Cloud API (Meta for Developers > WhatsApp > API Setup)
WA_TOKEN=
WA_PHONE_ID=
WA_VERIFY_TOKEN=choose-a-long-random-string
WA_APP_SECRET=
SALES_WHATSAPP=971525163638
# Optional approved templates (needed to message people outside the 24-hour window)
WA_TEMPLATE_SALES=
WA_TEMPLATE_CUSTOMER=
WA_TEMPLATE_LANG=en
# Optional
# WA_GRAPH_URL=https://graph.facebook.com/v21.0
# TRUST_PROXY=1            # set to 1 behind a reverse proxy so rate limiting sees real client IPs
# ALLOWED_ORIGIN=https://www.trivorauae.com   # only if the site is hosted separately from this API
